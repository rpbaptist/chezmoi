[user]
	name = Richard Baptist
	email = code@richardbaptist.nl
	signingkey = /home/richard/.ssh/richard_ed25519
[checkout]
  defaultRemote=origin
[color]
	diff = true
	status = true
	branch = true
	ui = auto
[core]
	; askpass = git-gui--askpass
	editor = "$VISUAL"
	excludesfile = ~/.gitignore
	commentChar = ";"
[push]
	default = current
	followTags = true
[rebase]
	autosquash = true
[commit]
	gpgsign = true
[pager]
  branch = false
[pull]
	ff = only
[init]
	defaultBranch = master
[diff]
	colorMoved = blocks
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.git_allowed_signers
[delta]
  syntax-theme = gruvbox-dark
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[column]
	status = never
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
