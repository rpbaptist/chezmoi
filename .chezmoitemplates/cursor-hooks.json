{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "{{ .chezmoi.homeDir }}/.cursor/hooks/session-start.sh"
      },
      {
        "command": "bash '{{ .chezmoi.homeDir }}/.cursor/herdr-agent-state.sh' session"
      }
    ],
    "preToolUse": [
      {
        "command": "rtk hook cursor",
        "matcher": "Shell"
      }
    ]
  }
}
