#!/bin/bash

# Recover Hyprland outputs after resume, a VT switch back, and a DPMS wake.
#
# DP-3: after resume, and after the hotplug events DP-3 sends when it wakes
# from DPMS off, Aquamarine falls back to the console mode (720x400@70). The
# kernel rejects that commit with EINVAL, so Hyprland renders nothing. A modeset
# of DP-3 alone keeps failing; the driver only accepts it with every head
# restated, which Aquamarine does when it restores after a VT switch. So force
# a VT round trip through logind, and fall back to a temporary mode.
#
# Session lock: after resume, or when the idle lock engages while another VT
# is active, the lock surface never paints. Hyprland shows a black screen with
# only a cursor and sends all input to the invisible lock. A DPMS off/on cycle
# and a reload while the session VT is active make the lock surface paint.
#
# Usage: hyprland-resume-modeset [--once]

OUTPUT=DP-3
OUTPUT_WIDTH=3440
TEMP_MODE="2560x1440@59.95"
SESSION_VT=1
SPARE_VT=6
SEAT=/org/freedesktop/login1/seat/seat0
LOCK="${XDG_RUNTIME_DIR:-/tmp}/hyprland-resume-modeset.lock"

on_session_vt() {
  [[ $(cat /sys/class/tty/tty0/active) == "tty$SESSION_VT" ]]
}

# A DPMS blank keeps the configured mode, so only a fallback mode means the
# wake failed.
output_degraded() {
  hyprctl -j monitors all |
    jq -e --arg o "$OUTPUT" --argjson w "$OUTPUT_WIDTH" '.[] | select(.name == $o) | .width != $w' >/dev/null
}

switch_vt() {
  busctl call org.freedesktop.login1 "$SEAT" org.freedesktop.login1.Seat SwitchTo u "$1"
}

restate_heads() {
  switch_vt "$SPARE_VT" || return 1
  sleep 1.5
  switch_vt "$SESSION_VT"
  sleep 3
  echo "Restated all heads with a VT round trip"
}

reapply_output() {
  hyprctl eval "hl.monitor({ output = \"$OUTPUT\", mode = \"$TEMP_MODE\", position = \"0x0\", scale = 1 })" >/dev/null
  sleep 2
  hyprctl reload >/dev/null
  echo "Re-applied $OUTPUT mode"
}

repaint_lock() {
  omarchy-hyprland-session-locked || return 0
  hyprctl dispatch 'hl.dsp.dpms("off")' >/dev/null
  sleep 1
  hyprctl dispatch 'hl.dsp.dpms("on")' >/dev/null
  sleep 2
  hyprctl reload >/dev/null
  echo "Cycled DPMS to repaint the lock screen"
}

# Commits fail with "Session inactive" while another VT is active, so a trigger
# seen from another VT is handled by the VT return instead. The VT round trip
# fires a VT return itself; the lock makes that event a no-op. A hotplug alone
# must not repaint: DP-3 also sends one while the lock keeps it blanked.
#
# Usage: recover <settle seconds> [repaint]
recover() {
  local settle=$1 repaint=$2
  sleep "$settle"
  on_session_vt || return 0
  (
    flock -n 9 || exit 0
    if output_degraded; then
      restate_heads
      output_degraded && reapply_output
      repaint=repaint
    fi
    [[ $repaint == repaint ]] && repaint_lock
  ) 9>"$LOCK"
}

if [[ $1 == --once ]]; then
  recover 0 repaint
  exit
fi

# Hotplug events arrive in bursts while the link retrains, so let the burst
# settle before checking the mode.
udevadm monitor --udev --subsystem-match=drm |
  while read -r line; do
    [[ $line == *" change "* ]] || continue
    while read -r -t 3 _; do :; done
    recover 0
  done &

# Without --object-path, the monitor also receives the PropertiesChanged
# signals of the session objects, which carry the VT switches.
gdbus monitor --system --dest org.freedesktop.login1 |
  while read -r line; do
    case $line in
      *"PrepareForSleep (false,)"*) recover 5 repaint ;;
      *"/session/"*"'Active': <true>"*) recover 2 repaint ;;
    esac
  done
