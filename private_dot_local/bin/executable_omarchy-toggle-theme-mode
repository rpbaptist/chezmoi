#!/bin/bash
# Toggle the active omarchy theme between its light and dark pair.
set -euo pipefail

THEME_DIR="$HOME/.config/omarchy/current/theme"
CURRENT=$(cat "$HOME/.config/omarchy/current/theme.name" 2>/dev/null || echo "")

declare -A TO_LIGHT=(
  [gruvbox]="gruvbox-light"
)
declare -A TO_DARK=(
  [gruvbox-light]="gruvbox"
)

if [[ -f "$THEME_DIR/light.mode" ]]; then
  target="${TO_DARK[$CURRENT]:-}"
else
  target="${TO_LIGHT[$CURRENT]:-}"
fi

if [[ -z "$target" ]]; then
  echo "No known light/dark pair for theme '$CURRENT'" >&2
  exit 1
fi

# Preserve whatever background the user has set (via Omarchy's menu) across
# the toggle — omarchy theme set otherwise cycles to the new theme's default.
OMARCHY_THEME_SKIP_BACKGROUND=1 omarchy theme set "$target"
