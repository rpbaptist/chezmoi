#!/bin/bash
# Toggle the active omarchy theme between its light and dark pair.
set -euo pipefail

THEME_DIR="$HOME/.local/state/omarchy/current/theme"
CURRENT=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null || echo "")

declare -A TO_LIGHT=(
  [gruvbox]="gruvbox-light"
)
declare -A TO_DARK=(
  [gruvbox-light]="gruvbox"
)

if [[ -f "$THEME_DIR/light.mode" ]]; then
  target="${TO_DARK[$CURRENT]:-}"
  target_mode="dark"
else
  target="${TO_LIGHT[$CURRENT]:-}"
  target_mode="light"
fi

if [[ -z "$target" ]]; then
  echo "No known light/dark pair for theme '$CURRENT'" >&2
  exit 1
fi

STATE_DIR="$HOME/.config/omarchy/state"
mkdir -p "$STATE_DIR"

# Skip omarchy's automatic background cycle -- each mode keeps its own last
# background (see omarchy-bg-set-remember, which records a pick from the
# Omarchy menu into $STATE_DIR/background-<mode>) and we restore it below.
OMARCHY_THEME_SKIP_BACKGROUND=1 omarchy theme set "$target"

SAVED_BG_FILE="$STATE_DIR/background-$target_mode"
if [[ -f "$SAVED_BG_FILE" ]] && [[ -f "$(cat "$SAVED_BG_FILE")" ]]; then
  omarchy-theme-bg-set "$(cat "$SAVED_BG_FILE")"
else
  omarchy-theme-bg-next
  readlink "$HOME/.local/state/omarchy/current/background" >"$SAVED_BG_FILE"
fi
