[user]
	name = Richard Baptist
{{- if .workDefault }}
	email = richard@wearereasonablepeople.com
	signingkey = {{ .chezmoi.homeDir }}/.ssh/warp_ed25519
[core]
	sshCommand = ssh -F /dev/null -i {{ .chezmoi.homeDir }}/.ssh/warp_ed25519 -o IdentitiesOnly=yes
; Port 22 is blocked on some networks; use GitHub's SSH endpoint on 443.
[url "ssh://git@ssh.github.com:443/"]
	insteadOf = git@github.com:
[includeIf "gitdir:{{ .chezmoi.sourceDir }}/"]
	path = ~/.gitconfig-personal
[includeIf "gitdir:{{ .chezmoi.homeDir }}/.config/nvim/"]
	path = ~/.gitconfig-personal
[includeIf "gitdir:{{ .chezmoi.homeDir }}/code/personal/"]
	path = ~/.gitconfig-personal
{{- else }}
	email = code@richardbaptist.nl
	signingkey = {{ .chezmoi.homeDir }}/.ssh/richard_ed25519
{{- end }}
[checkout]
  defaultRemote=origin
[color]
	diff = true
	status = true
	branch = true
	ui = auto
[core]
	; askpass = git-gui--askpass
	editor = "$VISUAL"
	excludesfile = ~/.gitignore
	commentChar = ";"
[push]
	default = current
	followTags = true
[rebase]
	autosquash = true
[commit]
	gpgsign = true
[pager]
  branch = false
[pull]
	ff = only
[init]
	defaultBranch = master
[diff]
	colorMoved = blocks
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.git_allowed_signers
[delta]
  syntax-theme = gruvbox-dark
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[column]
	status = never
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[hook "wt-prune-merged"]
	; Remove worktrees of merged PRs when main is pulled.
	command = {{ .chezmoi.homeDir }}/.local/bin/git-wt-prune-merged
	event = post-merge
