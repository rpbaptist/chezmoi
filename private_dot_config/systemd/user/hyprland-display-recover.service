[Unit]
Description=Recover Hyprland displays from console-mode fallback and unpainted lock
After=dbus.socket wayland-session-waitenv.service
Requires=dbus.socket
PartOf=graphical-session.target
ConditionEnvironment=HYPRLAND_INSTANCE_SIGNATURE

[Service]
Type=simple
ExecStart=%h/.local/bin/hyprland-display-recover
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
